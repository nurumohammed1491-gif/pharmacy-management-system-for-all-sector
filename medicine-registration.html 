<!DOCTYPE html>
<html lang="am">
<head>
  <meta charset="UTF-8">
  <title>Medicine Registration</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<h1>Medicine Registration</h1>

<form id="medicineForm">
  <label for="medicineName">Medicine Name:</label><br>
  <input type="text" id="medicineName"><br><br>

  <label for="batchNumber">Batch Number:</label><br>
  <input type="text" id="batchNumber"><br><br>

  <label for="quantity">Quantity:</label><br>
  <input type="number" id="quantity"><br><br>

  <label for="expiryDate">Expiry Date:</label><br>
  <input type="date" id="expiryDate"><br><br>

  <button type="submit">Save</button>
</form>

<h2>Registered Medicines</h2>

<table border="1">
  <thead>
    <tr>
      <th>Medicine Name</th>
      <th>Batch No</th>
      <th>Quantity</th>
      <th>Expiry Date</th>
    </tr>
  </thead>
  <tbody id="medicineTableBody">
    <!-- መረጃዎች በ JavaScript አማካኝነት እዚህ ይገባሉ -->
  </tbody>
</table>

<br>
<a href="index.html">Back to Home</a>

<script type="module" src="medicine.js"></script>

</body>
</html>
